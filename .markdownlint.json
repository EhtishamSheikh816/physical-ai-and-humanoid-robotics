{
  "default": true,
  "MD001": false,
  "MD003": {
    "style": "atx"
  },
  "MD004": {
    "style": "dash"
  },
  "MD007": {
    "indent": 2
  },
  "MD012": {
    "maximum": 2
  },
  "MD013": {
    "line_length": 120,
    "code_blocks": false,
    "tables": false
  },
  "MD022": {
    "lines_above": 1,
    "lines_below": 1
  },
  "MD024": {
    "allow_different_nesting": true
  },
  "MD025": {
    "front_matter_title": "^title$",
    "level": 1
  },
  "MD026": {
    "punctuation": ".,;:!"
  },
  "MD029": {
    "style": "ordered"
  },
  "MD033": {
    "allowed_elements": ["div", "span", "img", "br", "hr", "p", "h1", "h2", "h3", "h4", "h5", "h6", "strong", "em", "ul", "ol", "li", "a", "code", "pre", "table", "thead", "tbody", "tr", "th", "td"]
  },
  "MD035": {
    "style": "---"
  },
  "MD040": {
    "language_only": true
  },
  "MD046": {
    "style": "fenced"
  },
  "MD048": {
    "style": "fenced"
  }
}