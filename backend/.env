# OpenAI Configuration
OPENAI_API_KEY=sk-placeholder-key-for-development

# Qdrant Vector Database Configuration
QDRANT_URL=https://your-qdrant-instance.qdrant.tech
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION_NAME=book_content

# Neon PostgreSQL Configuration
NEON_DB_URL=postgresql+asyncpg://username:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# Application Configuration
APP_SECRET_KEY=supersecretkeyfordevelopment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Embedding Model Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Text Processing Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200